        android:strokeLineJoin="round"
        android:pathData="M54,23L76,32L85,54L76,76L54,85L32,76L23,54L32,32Z" />

    <!-- Sleek geometric Cyber Octocat silhouette (cat ears + rounded head & shoulders) -->
    <path
        android:fillColor="#FF0F172A"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round"
        android:pathData="M33,44C33,35 35,28 39,25C43,27 46,29 54,29C62,29 65,27 69,25C73,28 75,35 75,44C75,55 68,61 63,63C66,66 68,71 68,77L40,77C40,71 42,66 45,63C40,61 33,55 33,44Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="25"
                android:endX="75"
                android:endY="77"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF38BDF8" />
                <item android:offset="0.6" android:color="#FF6366F1" />
                <item android:offset="1.0" android:color="#FFA855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing cyan cyber visor eyes -->
    <path
        android:fillColor="@android:color/transparent"
