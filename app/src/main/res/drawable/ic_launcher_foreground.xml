    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Subtle outer octagonal cyber shield ring (within 66x66 safe zone: 23..85) -->
    <path
        android:fillColor="#141E293B"
        android:strokeColor="#4038BDF8"
